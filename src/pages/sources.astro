		label: 'General',
		accent: 'brass',
		sources: [
			{
				id: 'european-commission-2023',
				citation:
					'European Commission, Directorate-General for Agriculture and Rural Development. (2023, September 27). EU-Japan: An additional 42 geographical indications protected for both sides.',
			},
			{
