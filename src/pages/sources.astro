---

<BaseLayout title="Sources" description="Full source list for every figure, date and quote used in Asia Pours, grouped by ingredient.">
	<article class="mx-auto max-w-6xl px-6 py-16 flex flex-col gap-10">
		<header class="flex flex-col gap-4 max-w-2xl">
			<Eyebrow>References</Eyebrow>
			<PageTitle>Sources</PageTitle>
			<Deck>
				Figures were checked against the sources below in August 2026. Auction prices, export
				values and retail prices move. Verify anything time sensitive before quoting it on stage.
			</Deck>
		</header>

		<Hairline />

		<Callout label="A note on this list">
			<p>
				This list reproduces the reference page printed in the Asia Pours booklet. A separate
				formal APA source document (Asia_Pours_Sources.docx) was planned for this site but has not
				yet been supplied. <strong class="text-bone">[VERIFY: needs Asia_Pours_Sources.docx]</strong> If
				a fuller or corrected source list becomes available, this page should be updated from it
				rather than from the booklet excerpt.
			</p>
		</Callout>

		<div class="flex flex-col gap-12 max-w-3xl">
			{groups.map((group) => (
				<section class="flex flex-col gap-4">
					<h2 class:list={['font-label text-xs', {
						ube: 'text-ube',
						yuzu: 'text-yuzu',
						matcha: 'text-matcha',
						brass: 'text-brass',
					}[group.accent]]}>
						{group.label}
					</h2>
					<ol class="flex flex-col gap-4">
						{group.sources.map((source) => (
							<li id={source.id} class="text-sm leading-relaxed text-ash scroll-mt-24">
								{source.citation}
								{source.url && (
									<>
										{' '}
										<a href={source.url} class="text-steel hover:opacity-75 transition-opacity break-all">
											{source.url}
										</a>
									</>
								)}
							</li>
						))}
					</ol>
				</section>
			))}
		</div>
	</article>
</BaseLayout>
