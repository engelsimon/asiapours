---
// The Asia Pours mark: a martini glass, a brass sun on the liquid line, a leaf.
//
// Drawn as vector rather than traced from a raster so one source stays sharp at
// 16px in a browser tab and at 512px on a home screen.
//
// Two notes on the geometry, both of which cost an afternoon to find:
//
// The leaf is a lens built in its own local coordinates and then rotated into
// place, rather than an arc drawn directly between two points on the diagonal.
// Drawn directly, the sweep flags put the bulge on the side facing the bowl
// wall and the two bone shapes merged into one blob.
//
// Stroke width is 4, which is heavier than the reference artwork. The bowl
// walls slope inward steeply, so the space between the leaf and the right wall
// is the tightest part of the mark, and a thinner stroke that matched the
// reference exactly stopped reading at favicon sizes. 4 is the weight where the
// mark still holds together at 32px with that gap intact.
//
// The glass and leaf use `currentColor`, so the mark inherits whatever the
// parent is doing, including the bone-to-brass hover in the header. The sun is
// always brass: it is the one fixed accent, per the brand tokens.
//
// This component, public/favicon.svg and scripts/generate-icons.mjs carry the
// same path data. Change one, change all three, then run `npm run generate-icons`.
interface Props {
	size?: number;
	class?: string;
}

const { size = 26, class: className } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 128 128"
	fill="none"
	class={className}
	aria-hidden="true"
>
	<g
		stroke="currentColor"
		stroke-width="4"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="M9.9 6 L118.1 6 L67.5 62 L67.5 112 C67.5 117 72 120 92.9 122 L35.1 122 C56 120 60.5 117 60.5 112 L60.5 62 Z" />
		<path d="M33.4 32 L94.6 32" />
	</g>
	<path d="M44 32 a14.4 14.4 0 0 1 28.8 0 Z" fill="#C9A55F" />
	<g transform="translate(76,38) rotate(-45)">
		<path
			d="M-16 0 A24.33 24.33 0 0 1 16 0 A24.33 24.33 0 0 1 -16 0 Z"
			fill="currentColor"
		/>
	</g>
</svg>
