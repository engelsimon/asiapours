---
// Navigation icons, drawn by hand rather than pulled from an icon library.
// CLAUDE.md's "no icon sets" rule bars the library, not the icon: every path
// below is authored here, in the same line language as Mark.astro (round
// caps, round joins, currentColor) so the nav inherits its ash-to-brass hover
// with no extra styling.
//
// All are stroked, never filled, and sit on a 16 unit grid. Stroke is 1.25
// because these render at 14px next to 12px type: heavier reads as a button,
// lighter disappears against the slate.
//
// Two deliberate choices worth keeping if these are ever redrawn:
//   - Recipes is a coupe, not a martini glass, because the martini V is the
//     brand mark. Reusing it here would read as a logo in the nav.
//   - The Argument is a balance, not a speech bubble or a quote mark. The
//     chapter weighs three cases against each other, and a balance stays
//     legible at 14px where punctuation glyphs turn to mush.

// `download` is not a nav item. It lives here anyway because CLAUDE.md names
// this file as the home for every icon drawn by hand for the site, and one
// stray SVG inlined in a button is how a second, undocumented icon style
// starts.

interface Props {
	name: 'ingredients' | 'recipes' | 'bars' | 'argument' | 'sources' | 'finder' | 'download';
	size?: number;
	class?: string;
}

const { name, size = 14, class: className } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 16 16"
	fill="none"
	stroke="currentColor"
	stroke-width="1.25"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
>
	{/* Three ingredients, three circles. Ube, yuzu, matcha. */}
	{name === 'ingredients' && (
		<>
			<circle cx="5.2" cy="6" r="2.4" />
			<circle cx="10.8" cy="6" r="2.4" />
			<circle cx="8" cy="11" r="2.4" />
		</>
	)}

	{/* A coupe: bowl, stem, foot. */}
	{name === 'recipes' && (
		<>
			<path d="M3.2 4.6 H12.8 A4.8 4.8 0 0 1 3.2 4.6 Z" />
			<path d="M8 9.4 V12.6" />
			<path d="M5.6 12.6 H10.4" />
		</>
	)}

	{/* Map pin. */}
	{name === 'bars' && (
		<>
			<path d="M8 14.2 C8 14.2 12.6 9.8 12.6 6.6 A4.6 4.6 0 0 0 3.4 6.6 C3.4 9.8 8 14.2 8 14.2 Z" />
			<circle cx="8" cy="6.6" r="1.7" />
		</>
	)}

	{/* A balance: beam, two hanging pans, post and base.
	    The pans hang on short lines rather than sitting flush against the
	    beam. Drawn flush, the beam and pans merge into one mass at 14px and
	    the icon reads as a T with arrowheads. The 1.6 unit gap is what makes
	    it legible as a balance. */}
	{name === 'argument' && (
		<>
			<path d="M2.6 4.6 H13.4" />
			<path d="M8 4.6 V12.4" />
			<path d="M5.6 12.4 H10.4" />
			<path d="M2.6 4.6 V6.2" />
			<path d="M13.4 4.6 V6.2" />
			<path d="M1.2 6.2 A1.4 1.4 0 0 0 4 6.2 Z" />
			<path d="M12 6.2 A1.4 1.4 0 0 0 14.8 6.2 Z" />
		</>
	)}

	{/* An open book. */}
	{name === 'sources' && (
		<>
			<path d="M8 5 C6.4 4 4.4 4 2.6 4.5 V11.9 C4.4 11.4 6.4 11.4 8 12.4" />
			<path d="M8 5 C9.6 4 11.6 4 13.4 4.5 V11.9 C11.6 11.4 9.6 11.4 8 12.4" />
			<path d="M8 5 V12.4" />
		</>
	)}

	{/* Magnifying glass. */}
	{name === 'finder' && (
		<>
			<circle cx="7.1" cy="7.1" r="4.1" />
			<path d="M10.2 10.2 L13.6 13.6" />
		</>
	)}

	{/* Arrow descending into an open tray. The tray is drawn as two uprights
	    and a floor rather than a closed rectangle, so the shaft has somewhere
	    to land: a full box reads as an inbox, and the arrow then looks like it
	    is pointing at a lid. */}
	{name === 'download' && (
		<>
			<path d="M8 2.6 V9.8" />
			<path d="M5 7 L8 10 L11 7" />
			<path d="M2.8 11.2 V13.4 H13.2 V11.2" />
		</>
	)}
</svg>
