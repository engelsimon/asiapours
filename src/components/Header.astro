---
const navLinks = [
  { label: 'Ingredients', href: '/#ingredients' },
  { label: 'Recipes', href: '/recipes' },
  { label: 'The Argument', href: '/the-argument' },
  { label: 'Sources', href: '/sources' },
  { label: 'Find your drink', href: '/finder' },
];
---

<header class="border-b border-rule">
	<div class="mx-auto max-w-6xl px-6 py-6 flex items-center justify-between gap-6">
		<a href="/" class="font-label text-sm text-bone hover:text-brass transition-colors">
			Asia Pours
		</a>
		<nav aria-label="Primary">
			<ul class="flex flex-wrap items-center gap-x-8 gap-y-2">
				{navLinks.map((link) => (
					<li>
						<a
							href={link.href}
							class="font-label text-xs text-ash hover:text-brass transition-colors"
						>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>
