---
interface Props {
	value: string;
	label: string;
	source: string;
}

const { value, label, source } = Astro.props;
---

<div class="flex flex-col gap-1">
	<p class="font-serif text-4xl sm:text-5xl text-brass leading-none">{value}</p>
	<p class="text-sm text-bone">{label}</p>
	<p class="text-xs text-mist">Source: {source}</p>
</div>
