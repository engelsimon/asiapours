---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}

// Pages that have their own photograph should pass `image`. Everything else
// falls back to the mark on slate, which travels better than a cropped hero:
// social cards are 1.91:1 and the hero is not.
const { title, description, image = '/og-default.jpg' } = Astro.props;

const pageTitle = `${title} · Asia Pours`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<!-- SVG first: browsers that support it take it and get a sharp mark at
		     any density. The .ico is the fallback for those that do not. -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#15191F" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Asia Pours" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
	</head>
	{/* A flex column of exactly one viewport, with main taking up the slack.
	    Two things fall out of it. The footer stays at the bottom on pages too
	    short to fill the screen, instead of riding up under the content. And a
	    section can ask for the full remaining height with `min-h-full` and get
	    the screen minus the header, rather than the screen, which is what the
	    home page hero needs: measured against the whole viewport it centers its
	    content a header's worth too low and pushes the photo caption onto the
	    fold. */}
	<body class="bg-slate text-bone font-serif antialiased min-h-dvh flex flex-col">
		<a
			href="#content"
			class="font-label sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-brass focus:text-slate focus:px-4 focus:py-2 text-xs"
		>
			Skip to content
		</a>
		<Header />
		<main id="content" class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
