---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import PageTitle from '../components/PageTitle.astro';
import Deck from '../components/Deck.astro';
import Hairline from '../components/Hairline.astro';
import Callout from '../components/Callout.astro';
import Figure from '../components/Figure.astro';
import StatLine from '../components/StatLine.astro';

interface Props {
	entry: CollectionEntry<'chapters'>;
}

const { entry } = Astro.props;
const { title, place, accent, botanicalName, flavorDescription, originFigure, callouts, stats, inTheGlass, recipes, chapterNumber } =
	entry.data;
const { Content } = await render(entry);

const accentText = {
	ube: 'text-ube',
	yuzu: 'text-yuzu',
	matcha: 'text-matcha',
}[accent];
---

<BaseLayout title={title} description={flavorDescription}>
	<article class="mx-auto max-w-2xl px-6 py-16 flex flex-col gap-10">
		<header class="flex flex-col gap-4">
			<Eyebrow accent={accent}>Chapter {chapterNumber} &middot; {place}</Eyebrow>
			<PageTitle>
				<span class={accentText}>{title}</span>
			</PageTitle>
			<Deck>
				<span class="not-italic font-sans text-sm text-mist">{botanicalName}.</span> {flavorDescription}
			</Deck>
		</header>

		<Hairline />

		<div class="chapter-body flex flex-col gap-6 text-base leading-relaxed text-bone">
			<Content />
		</div>

		<Figure src={originFigure.src} alt={originFigure.alt} caption={originFigure.caption} aspect="3:2" />

		<div class="flex flex-col gap-6">
			{callouts.map((callout) => (
				<Callout label={callout.label} accent={accent}>
					{callout.body}
				</Callout>
			))}
		</div>

		<div class="grid gap-8 sm:grid-cols-3 py-4">
			{stats.map((stat) => (
				<StatLine value={stat.value} label={stat.label} source={stat.source} />
			))}
		</div>

		<Hairline />

		<footer class="flex flex-col gap-4">
			<p class="text-base leading-relaxed text-bone">
				<span class="font-label text-xs text-brass mr-2">In the glass</span>
				{inTheGlass}
			</p>
			<div class="flex flex-wrap items-center gap-6">
				{recipes.map((recipe) => (
					<a href={`/recipes/${recipe.slug}`} class={`font-label text-xs hover:opacity-75 transition-opacity ${accentText}`}>
						{recipe.name} &rarr;
					</a>
				))}
			</div>
		</footer>
	</article>
</BaseLayout>

<style>
	.chapter-body :global(h2) {
		font-family: var(--font-sans);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.8rem;
		color: var(--color-ash);
		margin-top: 0.5rem;
	}
</style>
